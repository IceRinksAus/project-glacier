generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MANAGER
  STAFF
  SCANNER
}

enum OrganizationAccessScope {
  ALL_EVENTS
  ASSIGNED_EVENTS
}

enum BookingSource {
  ONLINE
  WALK_UP
}

enum PaymentMethod {
  ONLINE_CARD
  CASH
  STANDALONE_EFTPOS
}

model Organization {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  status String @default("ACTIVE")

  legalName   String?
  tradingName String?
  abn         String?

  addressLine1 String?
  addressLine2 String?
  suburb       String?
  state        String?
  postcode     String?
  country      String? @default("AU")

  contactEmail String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events                        Event[]
  users                         UserOrganization[]
  ticketScanAttempts            TicketScanAttempt[]
  fileAssets                    FileAsset[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  eventGroups                   EventGroup[]
  accessAuditEntries            OrganizationAccessAudit[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventRoles                    EventUser[]
  eventAccess                   UserEventAccess[]
  organizations                 UserOrganization[]
  publishedWaiverVersions       WaiverVersion[]
  ticketScanAttempts            TicketScanAttempt[]
  createdFileAssets             FileAsset[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  paymentsReceived              Payment[]                      @relation("PaymentReceivedBy")
  accessChangesMade             OrganizationAccessAudit[]      @relation("OrganizationAccessAuditActor")
  accessChangesReceived         OrganizationAccessAudit[]      @relation("OrganizationAccessAuditTarget")
}

model EventGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String  @default("CUSTOM")
  status      String  @default("ACTIVE")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  events EventGroupEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model EventGroupEvent {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)

  eventGroupId String
  eventGroup   EventGroup @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventGroupId, eventId])
  @@index([eventId])
  @@index([eventGroupId, sortOrder])
}

model UserOrganization {
  id             String                  @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole        @default(STAFF)
  accessScope    OrganizationAccessScope @default(ALL_EVENTS)
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model OrganizationAccessAudit {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  actorUserId String
  actorUser   User   @relation("OrganizationAccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  targetUserId String
  targetUser   User   @relation("OrganizationAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  action String
  before Json?
  after  Json

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetUserId, createdAt])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  startDate   DateTime
  endDate     DateTime
  timezone    String?
  status      String   @default("DRAFT")

  venueName    String?
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  postcode     String?
  country      String? @default("AU")

  jurisdiction AustralianJurisdiction?
  activityType EventActivityType?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  team       EventUser[]
  userAccess UserEventAccess[]

  ticketTypes TicketType[]

  sessions Session[]

  operationalSchedules OperationalSchedule[]

  categories    Category[]
  products      Product[]
  productGroups ProductGroup[]

  bookings Booking[]

  rules Rule[]

  waiver                        EventWaiver?
  branding                      EventBranding?
  fileAssets                    FileAsset[]
  ticketScanAttempts            TicketScanAttempt[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  eventGroupMemberships         EventGroupEvent[]

  entryOpensMinutesBeforeStart Int @default(30)
  entryClosesMinutesAfterEnd   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventBranding {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  primaryColor    String  @default("#0F172A")
  secondaryColor  String  @default("#334155")
  accentColor     String  @default("#0EA5E9")
  backgroundColor String  @default("#FFFFFF")
  surfaceColor    String  @default("#F8FAFC")
  textColor       String  @default("#0F172A")
  headingFont     String  @default("INTER")
  bodyFont        String  @default("INTER")
  heroHeadline    String?
  heroDescription String?

  logoAssetId String?    @unique
  logoAsset   FileAsset? @relation("EventBrandingLogo", fields: [logoAssetId], references: [id])
  heroAssetId String?    @unique
  heroAsset   FileAsset? @relation("EventBrandingHero", fields: [heroAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FileAssetPurpose {
  EVENT_LOGO
  EVENT_HERO
}

enum FileAssetStatus {
  READY
  REPLACED
  FAILED
}

model FileAsset {
  id String @id @default(cuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id])

  purpose          FileAssetPurpose
  status           FileAssetStatus  @default(READY)
  storageProvider  String
  storageKey       String           @unique
  originalFilename String
  displayName      String
  mimeType         String
  fileSize         Int
  checksum         String
  width            Int
  height           Int

  usedAsLogo EventBranding? @relation("EventBrandingLogo")
  usedAsHero EventBranding? @relation("EventBrandingHero")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, eventId])
}

model OperationalSchedule {
  id String @id @default(cuid())

  name String

  pattern String

  startDate DateTime
  endDate   DateTime

  timetable Json

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  name String

  startDate DateTime
  endDate   DateTime

  capacity Int

  status String @default("DRAFT")

  salesStart DateTime?
  salesEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  operationalScheduleId String?
  operationalSchedule   OperationalSchedule? @relation(fields: [operationalScheduleId], references: [id])

  scheduleEntryId String?

  scheduleExceptionType String @default("NONE")

  bookings Booking[]

  sessionProducts SessionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  status    String @default("ACTIVE")
  sortOrder Int    @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@index([eventId])
}

model Product {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  productType String @default("ADMISSION")

  /**
   * Base price used when a product has no variants.
   * It may also act as the default price for its variants.
   */
  price Decimal @db.Decimal(10, 2)

  gstRate Float @default(10)

  /**
   * These fields support simple products that do not need variants.
   */
  sku      String?
  barcode  String?
  imageUrl String?

  status String @default("DRAFT")

  inventoryTracked  Boolean @default(false)
  inventoryQuantity Int?

  capacityControlled Boolean @default(false)
  capacity           Int?

  requiresSession Boolean @default(false)

  availableOnline Boolean @default(true)
  availablePos    Boolean @default(true)

  minQuantity Int  @default(0)
  maxQuantity Int?

  sortOrder Int @default(0)

  salesStart DateTime?
  salesEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  productGroupId String?
  productGroup   ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: SetNull)

  variants ProductVariant[]

  sessionProducts SessionProduct[]

  bookingProducts BookingProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@unique([eventId, sku])
  @@index([eventId])
  @@index([categoryId])
  @@index([productGroupId])
}

model ProductGroup {
  id String @id @default(cuid())

  name        String
  description String?
  sortOrder   Int     @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model ProductVariant {
  id String @id @default(cuid())

  name String
  slug String

  description String?

  /**
   * A variant may override the product's base price.
   * When null, Glacier will use Product.price.
   */
  priceOverride Decimal? @db.Decimal(10, 2)

  sku      String?
  barcode  String?
  imageUrl String?

  status String @default("ACTIVE")

  inventoryTracked  Boolean @default(false)
  inventoryQuantity Int?

  availableOnline Boolean @default(true)
  availablePos    Boolean @default(true)

  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  bookingProducts BookingProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, slug])
  @@unique([productId, sku])
  @@index([productId])
}

model SessionProduct {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  active Boolean @default(true)

  priceOverride Decimal? @db.Decimal(10, 2)

  capacityOverride Int?

  salesStart DateTime?
  salesEnd   DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
}

model TicketType {
  id String @id @default(cuid())

  name String

  description String?

  price Decimal @db.Decimal(10, 2)

  capacity Int

  active Boolean @default(true)

  saleStart DateTime?
  saleEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  bookingItems        BookingItem[]
  bookingParticipants BookingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String
  phone     String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(cuid())

  bookingNumber String @unique

  status String        @default("PENDING")
  source BookingSource @default(ONLINE)

  total Decimal @db.Decimal(10, 2)

  flexibleBooking Boolean @default(false)

  customerId String
  eventId    String

  customer Customer @relation(fields: [customerId], references: [id])

  event Event @relation(fields: [eventId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  items                         BookingItem[]
  participants                  BookingParticipant[]
  products                      BookingProduct[]
  tickets                       Ticket[]
  payments                      Payment[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]

  reservedUntil DateTime?
  confirmedAt   DateTime?
  paidAt        DateTime?
  expiredAt     DateTime?

  paymentStatus              String    @default("UNPAID")
  paymentReference           String?
  publicAccessTokenHash      String?   @unique
  publicAccessTokenCreatedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([eventId, source])
}

model BookingItem {
  id String @id @default(cuid())

  bookingId String

  ticketTypeId String

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id])

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  createdAt DateTime @default(now())
}

model BookingParticipant {
  id String @id @default(cuid())

  firstName String
  lastName  String?

  age Int

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([ticketTypeId])
}

model BookingProduct {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([productId])
  @@index([productVariantId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider String
  method   PaymentMethod @default(ONLINE_CARD)

  providerReference   String?
  standaloneReference String?
  idempotencyKey      String  @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AUD")

  status PaymentStatus @default(PENDING)

  failureCode    String?
  failureMessage String?

  succeededAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  receivedAt  DateTime?

  receivedByUserId String?
  receivedByUser   User?   @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds                PaymentRefund[]
  reconciliationAttempts PaymentReconciliationAttempt[]

  @@index([bookingId])
  @@index([provider, providerReference])
  @@index([method, status])
  @@index([receivedByUserId])
  @@index([status])
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model PaymentRefund {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider String

  providerReference String? @unique
  idempotencyKey    String  @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AUD")

  status PaymentRefundStatus @default(PENDING)

  reason String?

  failureCode    String?
  failureMessage String?

  succeededAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([provider, providerReference])
}

model PaymentReconciliationAttempt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  trigger        String         @default("MANUAL")
  outcome        String
  providerStatus PaymentStatus?
  succeeded      Boolean
  errorMessage   String?
  attemptedAt    DateTime       @default(now())

  @@index([organizationId, attemptedAt])
  @@index([eventId, attemptedAt])
  @@index([bookingId, attemptedAt])
  @@index([paymentId, attemptedAt])
  @@index([userId, attemptedAt])
}

model EventUser {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model UserEventAccess {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Ticket {
  id String @id @default(cuid())

  ticketNumber String @unique
  secureToken  String @unique

  status TicketStatus @default(ACTIVE)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  participantId String             @unique
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  issuedAt    DateTime  @default(now())
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanAttempts TicketScanAttempt[]
}

model TicketScanAttempt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  result TicketScanAttemptResult
  mode   TicketScanMode

  priorCheckedInAt DateTime?
  attemptedAt      DateTime  @default(now())

  @@index([organizationId, attemptedAt])
  @@index([eventId, attemptedAt])
  @@index([ticketId, attemptedAt])
  @@index([userId, attemptedAt])
}

model Rule {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  ruleType String
  scope    String @default("BOOKING")

  status   String @default("ACTIVE")
  priority Int    @default(0)

  conditions Json
  actions    Json

  message String?

  stopProcessing Boolean @default(false)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([eventId, status, priority])
}

model EventWaiver {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id])

  publicSlug String @unique

  versions    WaiverVersion[]
  submissions WaiverSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaiverTemplate {
  id String @id @default(cuid())

  name         String
  activityType EventActivityType
  jurisdiction AustralianJurisdiction
  revision     Int

  contentTemplate       String @db.Text
  acceptanceStatement   String @db.Text
  legislationReferences Json?

  status     WaiverTemplateStatus @default(DRAFT)
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waiverVersions WaiverVersion[]

  @@unique([activityType, jurisdiction, revision])
  @@index([activityType, jurisdiction, status])
}

enum AustralianJurisdiction {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum EventActivityType {
  ICE_SKATING
  OTHER
}

enum WaiverTemplateStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum WaiverVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum TicketStatus {
  ACTIVE
  SCANNED
  CANCELLED
}

enum TicketScanMode {
  GATE_ENTRY
  TICKET_LOOKUP
}

enum TicketScanAttemptResult {
  ENTRY_GRANTED
  ALREADY_SCANNED
  CANCELLED
  NOT_YET_VALID
  ENTRY_WINDOW_CLOSED
  WRONG_EVENT
  NOT_FOUND
  INVALID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model WaiverVersion {
  id String @id @default(cuid())

  eventWaiverId String
  eventWaiver   EventWaiver @relation(fields: [eventWaiverId], references: [id])

  sourceTemplateId String
  sourceTemplate   WaiverTemplate @relation(fields: [sourceTemplateId], references: [id])

  version Int

  title               String
  content             String @db.Text
  acceptanceStatement String @db.Text
  contentHash         String

  status WaiverVersionStatus @default(DRAFT)

  publishedAt       DateTime?
  publishedByUserId String?
  publishedByUser   User?     @relation(fields: [publishedByUserId], references: [id])

  createdAt DateTime @default(now())

  submissions WaiverSubmission[]

  @@unique([eventWaiverId, version])
  @@index([eventWaiverId, status])
}

model WaiverSubmission {
  id String @id @default(cuid())

  eventWaiverId String
  eventWaiver   EventWaiver @relation(fields: [eventWaiverId], references: [id])

  waiverVersionId String
  waiverVersion   WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  signatoryFullName String
  signatureData     String @db.Text

  acceptedAt DateTime @default(now())

  waiverContentHash       String
  acceptanceStatementHash String

  verificationTokenHash String @unique

  minors WaiverMinor[]

  createdAt DateTime @default(now())

  @@index([eventWaiverId, acceptedAt])
  @@index([waiverVersionId])
  @@index([signatoryFullName])
}

model WaiverMinor {
  id String @id @default(cuid())

  waiverSubmissionId String
  waiverSubmission   WaiverSubmission @relation(fields: [waiverSubmissionId], references: [id], onDelete: Cascade)

  fullName    String
  dateOfBirth DateTime @db.Date

  createdAt DateTime @default(now())

  @@index([waiverSubmissionId])
}
