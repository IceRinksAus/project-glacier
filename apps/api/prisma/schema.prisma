generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MANAGER
  STAFF
  SCANNER
}

enum OrganizationAccessScope {
  ALL_EVENTS
  ASSIGNED_EVENTS
}

enum BookingSource {
  ONLINE
  WALK_UP
}

enum PaymentMethod {
  ONLINE_CARD
  CASH
  STANDALONE_EFTPOS
}

enum RetailSaleStatus {
  RESERVED
  COMPLETED
  EXPIRED
}

enum RetailSalePaymentStatus {
  UNPAID
  PAID
}

enum FlexibleTicketEventMode {
  DISABLED
  INHERIT
  OVERRIDE
}

enum FlexibleTicketPolicyStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum FlexibleTicketFeeType {
  FIXED
  PERCENTAGE
}

enum FlexibleTicketPriceIncreaseTreatment {
  CUSTOMER_PAYS_DIFFERENCE
  CHANGE_NOT_PERMITTED
}

enum FlexibleTicketPriceDecreaseTreatment {
  KEEP_ORIGINAL_PRICE
  REFUND_DIFFERENCE
}

enum FlexibleTicketFeeRefundability {
  NON_REFUNDABLE
  REFUNDABLE_WITH_TICKET
  EVENT_CANCELLATION_ONLY
}

enum FlexibleTicketEntitlementStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Organization {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  status String @default("ACTIVE")

  legalName   String?
  tradingName String?
  abn         String?

  addressLine1 String?
  addressLine2 String?
  suburb       String?
  state        String?
  postcode     String?
  country      String? @default("AU")

  contactEmail String?
  contactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events                        Event[]
  users                         UserOrganization[]
  ticketScanAttempts            TicketScanAttempt[]
  fileAssets                    FileAsset[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  eventGroups                   EventGroup[]
  accessAuditEntries            OrganizationAccessAudit[]
  ticketAdjustments             TicketAdjustment[]
  bookingReschedules            BookingReschedule[]
  flexibleTicketPolicies        FlexibleTicketPolicy[]
  flexibleTicketEntitlements    FlexibleTicketEntitlement[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventRoles                      EventUser[]
  eventAccess                     UserEventAccess[]
  organizations                   UserOrganization[]
  publishedWaiverVersions         WaiverVersion[]
  ticketScanAttempts              TicketScanAttempt[]
  createdFileAssets               FileAsset[]
  paymentReconciliationAttempts   PaymentReconciliationAttempt[]
  paymentsReceived                Payment[]                      @relation("PaymentReceivedBy")
  retailSalesCreated              RetailSale[]                   @relation("RetailSaleCreatedBy")
  retailSalesCompleted            RetailSale[]                   @relation("RetailSaleCompletedBy")
  ticketAdjustmentsRequested      TicketAdjustment[]             @relation("TicketAdjustmentRequestedBy")
  bookingReschedulesRequested     BookingReschedule[]            @relation("BookingRescheduleRequestedBy")
  flexibleTicketPoliciesCreated   FlexibleTicketPolicy[]         @relation("FlexibleTicketPolicyCreatedBy")
  flexibleTicketPoliciesPublished FlexibleTicketPolicy[]         @relation("FlexibleTicketPolicyPublishedBy")
  accessChangesMade               OrganizationAccessAudit[]      @relation("OrganizationAccessAuditActor")
  accessChangesReceived           OrganizationAccessAudit[]      @relation("OrganizationAccessAuditTarget")
}

model EventGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String  @default("CUSTOM")
  status      String  @default("ACTIVE")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  events EventGroupEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model EventGroupEvent {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)

  eventGroupId String
  eventGroup   EventGroup @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventGroupId, eventId])
  @@index([eventId])
  @@index([eventGroupId, sortOrder])
}

model UserOrganization {
  id             String                  @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole        @default(STAFF)
  accessScope    OrganizationAccessScope @default(ALL_EVENTS)
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model OrganizationAccessAudit {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  actorUserId String
  actorUser   User   @relation("OrganizationAccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  targetUserId String
  targetUser   User   @relation("OrganizationAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  action String
  before Json?
  after  Json

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetUserId, createdAt])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  startDate   DateTime
  endDate     DateTime
  timezone    String?
  status      String   @default("DRAFT")

  flexibleTicketMode FlexibleTicketEventMode @default(DISABLED)

  venueName    String?
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  postcode     String?
  country      String? @default("AU")

  jurisdiction AustralianJurisdiction?
  activityType EventActivityType?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  team       EventUser[]
  userAccess UserEventAccess[]

  ticketTypes TicketType[]

  sessions Session[]

  operationalSchedules OperationalSchedule[]

  categories    Category[]
  products      Product[]
  productGroups ProductGroup[]

  bookings                   Booking[]
  retailSales                RetailSale[]
  ticketAdjustments          TicketAdjustment[]
  bookingReschedules         BookingReschedule[]
  flexibleTicketPolicies     FlexibleTicketPolicy[]
  flexibleTicketEntitlements FlexibleTicketEntitlement[]

  rules Rule[]

  waiver                        EventWaiver?
  branding                      EventBranding?
  fileAssets                    FileAsset[]
  ticketScanAttempts            TicketScanAttempt[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  eventGroupMemberships         EventGroupEvent[]

  entryOpensMinutesBeforeStart Int @default(30)
  entryClosesMinutesAfterEnd   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventBranding {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  primaryColor    String  @default("#0F172A")
  secondaryColor  String  @default("#334155")
  accentColor     String  @default("#0EA5E9")
  backgroundColor String  @default("#FFFFFF")
  surfaceColor    String  @default("#F8FAFC")
  textColor       String  @default("#0F172A")
  headingFont     String  @default("INTER")
  bodyFont        String  @default("INTER")
  heroHeadline    String?
  heroDescription String?

  logoAssetId String?    @unique
  logoAsset   FileAsset? @relation("EventBrandingLogo", fields: [logoAssetId], references: [id])
  heroAssetId String?    @unique
  heroAsset   FileAsset? @relation("EventBrandingHero", fields: [heroAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FileAssetPurpose {
  EVENT_LOGO
  EVENT_HERO
}

enum FileAssetStatus {
  READY
  REPLACED
  FAILED
}

model FileAsset {
  id String @id @default(cuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id])

  purpose          FileAssetPurpose
  status           FileAssetStatus  @default(READY)
  storageProvider  String
  storageKey       String           @unique
  originalFilename String
  displayName      String
  mimeType         String
  fileSize         Int
  checksum         String
  width            Int
  height           Int

  usedAsLogo EventBranding? @relation("EventBrandingLogo")
  usedAsHero EventBranding? @relation("EventBrandingHero")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, eventId])
}

model OperationalSchedule {
  id String @id @default(cuid())

  name String

  pattern String

  startDate DateTime
  endDate   DateTime

  timetable Json

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  name String

  startDate DateTime
  endDate   DateTime

  capacity Int

  status String @default("DRAFT")

  salesStart DateTime?
  salesEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  operationalScheduleId String?
  operationalSchedule   OperationalSchedule? @relation(fields: [operationalScheduleId], references: [id])

  scheduleEntryId String?

  scheduleExceptionType String @default("NONE")

  bookings Booking[]

  originalBookingReschedules    BookingReschedule[] @relation("BookingRescheduleOriginalSession")
  destinationBookingReschedules BookingReschedule[] @relation("BookingRescheduleDestinationSession")

  sessionProducts SessionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  status    String @default("ACTIVE")
  sortOrder Int    @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@index([eventId])
}

model Product {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  productType String @default("ADMISSION")

  /**
   * Base price used when a product has no variants.
   * It may also act as the default price for its variants.
   */
  price Decimal @db.Decimal(10, 2)

  gstRate Float @default(10)

  /**
   * These fields support simple products that do not need variants.
   */
  sku      String?
  barcode  String?
  imageUrl String?

  status String @default("DRAFT")

  inventoryTracked  Boolean @default(false)
  inventoryQuantity Int?

  capacityControlled Boolean @default(false)
  capacity           Int?

  requiresSession Boolean @default(false)

  availableOnline Boolean @default(true)
  availablePos    Boolean @default(true)

  minQuantity Int  @default(0)
  maxQuantity Int?

  sortOrder Int @default(0)

  salesStart DateTime?
  salesEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  productGroupId String?
  productGroup   ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: SetNull)

  variants ProductVariant[]

  sessionProducts SessionProduct[]

  bookingProducts              BookingProduct[]
  retailSaleItems              RetailSaleItem[]
  rescheduleProductAllocations BookingRescheduleProductAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@unique([eventId, sku])
  @@index([eventId])
  @@index([categoryId])
  @@index([productGroupId])
}

model ProductGroup {
  id String @id @default(cuid())

  name        String
  description String?
  sortOrder   Int     @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model ProductVariant {
  id String @id @default(cuid())

  name String
  slug String

  description String?

  /**
   * A variant may override the product's base price.
   * When null, Glacier will use Product.price.
   */
  priceOverride Decimal? @db.Decimal(10, 2)

  sku      String?
  barcode  String?
  imageUrl String?

  status String @default("ACTIVE")

  inventoryTracked  Boolean @default(false)
  inventoryQuantity Int?

  availableOnline Boolean @default(true)
  availablePos    Boolean @default(true)

  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  bookingProducts BookingProduct[]
  retailSaleItems RetailSaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, slug])
  @@unique([productId, sku])
  @@index([productId])
}

model SessionProduct {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  active Boolean @default(true)

  priceOverride Decimal? @db.Decimal(10, 2)

  capacityOverride Int?

  salesStart DateTime?
  salesEnd   DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
}

model TicketType {
  id String @id @default(cuid())

  name String

  description String?

  price Decimal @db.Decimal(10, 2)

  capacity Int

  active Boolean @default(true)

  saleStart DateTime?
  saleEnd   DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  bookingItems               BookingItem[]
  bookingParticipants        BookingParticipant[]
  adjustmentAllocations      TicketAdjustmentAllocation[]
  rescheduleTicketMappings   BookingRescheduleTicket[]
  flexibleTicketEntitlements FlexibleTicketEntitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String?
  phone     String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(cuid())

  bookingNumber String @unique

  status String        @default("PENDING")
  source BookingSource @default(ONLINE)

  total Decimal @db.Decimal(10, 2)

  flexibleBooking Boolean @default(false)

  customerId String
  eventId    String

  customer Customer @relation(fields: [customerId], references: [id])

  event Event @relation(fields: [eventId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  items                         BookingItem[]
  participants                  BookingParticipant[]
  products                      BookingProduct[]
  tickets                       Ticket[]
  payments                      Payment[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]
  ticketAdjustments             TicketAdjustment[]
  reschedules                   BookingReschedule[]
  flexibleTicketEntitlements    FlexibleTicketEntitlement[]

  reservedUntil DateTime?
  confirmedAt   DateTime?
  paidAt        DateTime?
  expiredAt     DateTime?

  paymentStatus              String    @default("UNPAID")
  paymentReference           String?
  publicAccessTokenHash      String?   @unique
  publicAccessTokenCreatedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([eventId, source])
}

model BookingItem {
  id String @id @default(cuid())

  bookingId String

  ticketTypeId String

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id])

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  createdAt DateTime @default(now())
}

model BookingParticipant {
  id String @id @default(cuid())

  firstName String
  lastName  String?

  age Int

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  tickets                   Ticket[]
  adjustmentAllocations     TicketAdjustmentAllocation[]
  rescheduleTicketMappings  BookingRescheduleTicket[]
  flexibleTicketEntitlement FlexibleTicketEntitlement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([ticketTypeId])
}

model BookingProduct {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  rescheduleProductAllocations BookingRescheduleProductAllocation[]

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([productId])
  @@index([productVariantId])
}

model RetailSale {
  id String @id @default(cuid())

  saleNumber String @unique

  status        RetailSaleStatus        @default(RESERVED)
  paymentStatus RetailSalePaymentStatus @default(UNPAID)

  total    Decimal @db.Decimal(10, 2)
  currency String  @default("AUD")

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  createdByUserId String
  createdByUser   User   @relation("RetailSaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  completedByUserId String?
  completedByUser   User?   @relation("RetailSaleCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  reservedUntil DateTime
  completedAt   DateTime?
  expiredAt     DateTime?

  items    RetailSaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([completedByUserId, completedAt])
}

model RetailSaleItem {
  id String @id @default(cuid())

  retailSaleId String
  retailSale   RetailSale @relation(fields: [retailSaleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  productNameSnapshot String
  variantNameSnapshot String?
  skuSnapshot         String?
  barcodeSnapshot     String?

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  gstRate   Float
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([retailSaleId])
  @@index([productId])
  @@index([productVariantId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  retailSaleId String?
  retailSale   RetailSale? @relation(fields: [retailSaleId], references: [id], onDelete: Cascade)

  provider String
  method   PaymentMethod @default(ONLINE_CARD)

  providerReference   String?
  standaloneReference String?
  idempotencyKey      String  @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AUD")

  status PaymentStatus @default(PENDING)

  failureCode    String?
  failureMessage String?

  succeededAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  receivedAt  DateTime?

  receivedByUserId String?
  receivedByUser   User?   @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds                    PaymentRefund[]
  reconciliationAttempts     PaymentReconciliationAttempt[]
  ticketAdjustments          TicketAdjustment[]
  flexibleTicketEntitlements FlexibleTicketEntitlement[]

  @@index([bookingId])
  @@index([retailSaleId])
  @@index([provider, providerReference])
  @@index([method, status])
  @@index([receivedByUserId])
  @@index([status])
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model PaymentRefund {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider String

  providerReference String? @unique
  idempotencyKey    String  @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AUD")

  status PaymentRefundStatus @default(PENDING)

  reason String?

  failureCode    String?
  failureMessage String?

  succeededAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketAdjustment TicketAdjustment?

  @@index([paymentId])
  @@index([status])
  @@index([provider, providerReference])
}

model FlexibleTicketPolicy {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  version Int
  status  FlexibleTicketPolicyStatus @default(DRAFT)

  available Boolean @default(false)

  feeType  FlexibleTicketFeeType
  feeValue Decimal               @db.Decimal(10, 2)
  currency String                @default("AUD")

  allowsSessionChange        Boolean
  allowsRefundRequest        Boolean
  cutoffMinutesBeforeSession Int
  permittedUseLimit          Int

  priceIncreaseTreatment FlexibleTicketPriceIncreaseTreatment
  priceDecreaseTreatment FlexibleTicketPriceDecreaseTreatment
  feeRefundability       FlexibleTicketFeeRefundability

  customerSummary String @db.Text
  materialTerms   String @db.Text

  createdByUserId String
  createdByUser   User   @relation("FlexibleTicketPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  publishedByUserId String?
  publishedByUser   User?   @relation("FlexibleTicketPolicyPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  publishedAt  DateTime?
  supersededAt DateTime?

  entitlements FlexibleTicketEntitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, version])
  @@index([organizationId, status, createdAt])
  @@index([eventId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([publishedByUserId, publishedAt])
}

model FlexibleTicketEntitlement {
  id                String                          @id @default(cuid())
  entitlementNumber String                          @unique
  status            FlexibleTicketEntitlementStatus @default(PENDING)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  participantId String             @unique
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  initialTicketId String? @unique
  initialTicket   Ticket? @relation(fields: [initialTicketId], references: [id], onDelete: Restrict)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  policyId String
  policy   FlexibleTicketPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  activatedByPaymentId String?
  activatedByPayment   Payment? @relation(fields: [activatedByPaymentId], references: [id], onDelete: Restrict)

  policySourceMode FlexibleTicketEventMode
  policyVersion    Int

  ticketTypeNameSnapshot  String
  ticketFaceValueSnapshot Decimal @db.Decimal(10, 2)

  feeTypeSnapshot  FlexibleTicketFeeType
  feeValueSnapshot Decimal               @db.Decimal(10, 2)
  feeAmount        Decimal               @db.Decimal(10, 2)
  currency         String                @default("AUD")

  allowsSessionChangeSnapshot        Boolean
  allowsRefundRequestSnapshot        Boolean
  cutoffMinutesBeforeSessionSnapshot Int
  permittedUseLimitSnapshot          Int
  remainingUses                      Int

  priceIncreaseTreatmentSnapshot FlexibleTicketPriceIncreaseTreatment
  priceDecreaseTreatmentSnapshot FlexibleTicketPriceDecreaseTreatment
  feeRefundabilitySnapshot       FlexibleTicketFeeRefundability

  customerSummarySnapshot String @db.Text
  materialTermsSnapshot   String @db.Text

  activatedAt DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([bookingId, createdAt])
  @@index([policyId, createdAt])
  @@index([status, createdAt])
  @@index([ticketTypeId])
  @@index([activatedByPaymentId])
}

enum BookingRescheduleStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BookingRescheduleReason {
  CUSTOMER_REQUEST
  EVENT_SESSION_ISSUE
  ORGANISER_CORRECTION
  OTHER
}

model BookingReschedule {
  id               String                  @id @default(cuid())
  rescheduleNumber String                  @unique
  idempotencyKey   String                  @unique
  status           BookingRescheduleStatus @default(PENDING)
  reason           BookingRescheduleReason
  note             String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  originalSessionId String
  originalSession   Session @relation("BookingRescheduleOriginalSession", fields: [originalSessionId], references: [id], onDelete: Restrict)

  destinationSessionId String
  destinationSession   Session @relation("BookingRescheduleDestinationSession", fields: [destinationSessionId], references: [id], onDelete: Restrict)

  originalSessionNameSnapshot     String
  originalSessionStartSnapshot    DateTime
  destinationSessionNameSnapshot  String
  destinationSessionStartSnapshot DateTime

  requestedByUserId String
  requestedByUser   User   @relation("BookingRescheduleRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  ticketCount                Int
  admissionPlacesTransferred Int

  completedAt    DateTime?
  failedAt       DateTime?
  failureCode    String?
  failureMessage String?

  ticketMappings     BookingRescheduleTicket[]
  productAllocations BookingRescheduleProductAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([bookingId, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([status, createdAt])
  @@index([originalSessionId, createdAt])
  @@index([destinationSessionId, createdAt])
}

model BookingRescheduleTicket {
  id String @id @default(cuid())

  rescheduleId String
  reschedule   BookingReschedule @relation(fields: [rescheduleId], references: [id], onDelete: Restrict)

  originalTicketId String @unique
  originalTicket   Ticket @relation("BookingRescheduleOriginalTicket", fields: [originalTicketId], references: [id], onDelete: Restrict)

  replacementTicketId String? @unique
  replacementTicket   Ticket? @relation("BookingRescheduleReplacementTicket", fields: [replacementTicketId], references: [id], onDelete: Restrict)

  participantId String
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  participantNameSnapshot         String
  ticketTypeNameSnapshot          String
  originalTicketNumberSnapshot    String
  replacementTicketNumberSnapshot String?

  createdAt DateTime @default(now())

  @@index([rescheduleId])
  @@index([participantId])
  @@index([ticketTypeId])
}

model BookingRescheduleProductAllocation {
  id String @id @default(cuid())

  rescheduleId String
  reschedule   BookingReschedule @relation(fields: [rescheduleId], references: [id], onDelete: Restrict)

  bookingProductId String
  bookingProduct   BookingProduct @relation(fields: [bookingProductId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productNameSnapshot         String
  variantNameSnapshot         String?
  quantity                    Int
  capacityTransferred         Int
  originalSessionProductId    String?
  destinationSessionProductId String?

  createdAt DateTime @default(now())

  @@unique([rescheduleId, bookingProductId], map: "BookingRescheduleProductAllocation_rescheduleId_bookingProductI")
  @@index([bookingProductId])
  @@index([productId])
}

enum TicketAdjustmentAction {
  CANCEL_ONLY
  CANCEL_AND_REFUND
}

enum TicketAdjustmentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TicketAdjustmentReason {
  MEDICAL_COMPASSIONATE
  EVENT_SESSION_ISSUE
  DUPLICATE_PURCHASE
  ORGANISER_CORRECTION
  OTHER
}

model TicketAdjustment {
  id               String                 @id @default(cuid())
  adjustmentNumber String                 @unique
  idempotencyKey   String                 @unique
  action           TicketAdjustmentAction
  status           TicketAdjustmentStatus @default(PENDING)
  reason           TicketAdjustmentReason
  note             String

  requestedAmount Decimal @db.Decimal(10, 2)
  refundedAmount  Decimal @default(0) @db.Decimal(10, 2)
  currency        String  @default("AUD")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  paymentRefundId String?        @unique
  paymentRefund   PaymentRefund? @relation(fields: [paymentRefundId], references: [id], onDelete: Restrict)

  requestedByUserId String
  requestedByUser   User   @relation("TicketAdjustmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  completedAt        DateTime?
  failedAt           DateTime?
  capacityReleasedAt DateTime?
  failureCode        String?
  failureMessage     String?
  externalReference  String?

  allocations TicketAdjustmentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([bookingId, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
}

model TicketAdjustmentAllocation {
  id String @id @default(cuid())

  adjustmentId String
  adjustment   TicketAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  participantId String
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  participantNameSnapshot String
  ticketNumberSnapshot    String
  ticketTypeNameSnapshot  String
  unitValue               Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([adjustmentId])
  @@index([participantId])
  @@index([ticketTypeId])
}

model PaymentReconciliationAttempt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  trigger        String         @default("MANUAL")
  outcome        String
  providerStatus PaymentStatus?
  succeeded      Boolean
  errorMessage   String?
  attemptedAt    DateTime       @default(now())

  @@index([organizationId, attemptedAt])
  @@index([eventId, attemptedAt])
  @@index([bookingId, attemptedAt])
  @@index([paymentId, attemptedAt])
  @@index([userId, attemptedAt])
}

model EventUser {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model UserEventAccess {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Ticket {
  id String @id @default(cuid())

  ticketNumber String @unique
  secureToken  String @unique

  status TicketStatus @default(ACTIVE)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  participantId String
  participant   BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  issuedAt    DateTime  @default(now())
  checkedInAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanAttempts                     TicketScanAttempt[]
  adjustmentAllocation             TicketAdjustmentAllocation?
  originalRescheduleMapping        BookingRescheduleTicket?    @relation("BookingRescheduleOriginalTicket")
  replacementRescheduleMapping     BookingRescheduleTicket?    @relation("BookingRescheduleReplacementTicket")
  initialFlexibleTicketEntitlement FlexibleTicketEntitlement?

  @@index([participantId])
}

model TicketScanAttempt {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  result TicketScanAttemptResult
  mode   TicketScanMode

  priorCheckedInAt DateTime?
  attemptedAt      DateTime  @default(now())

  @@index([organizationId, attemptedAt])
  @@index([eventId, attemptedAt])
  @@index([ticketId, attemptedAt])
  @@index([userId, attemptedAt])
}

model Rule {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?

  ruleType String
  scope    String @default("BOOKING")

  status   String @default("ACTIVE")
  priority Int    @default(0)

  conditions Json
  actions    Json

  message String?

  stopProcessing Boolean @default(false)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([eventId, status, priority])
}

model EventWaiver {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id])

  publicSlug String @unique

  versions    WaiverVersion[]
  submissions WaiverSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaiverTemplate {
  id String @id @default(cuid())

  name         String
  activityType EventActivityType
  jurisdiction AustralianJurisdiction
  revision     Int

  contentTemplate       String @db.Text
  acceptanceStatement   String @db.Text
  legislationReferences Json?

  status     WaiverTemplateStatus @default(DRAFT)
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waiverVersions WaiverVersion[]

  @@unique([activityType, jurisdiction, revision])
  @@index([activityType, jurisdiction, status])
}

enum AustralianJurisdiction {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum EventActivityType {
  ICE_SKATING
  OTHER
}

enum WaiverTemplateStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum WaiverVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum TicketStatus {
  ACTIVE
  SCANNED
  CANCELLED
}

enum TicketScanMode {
  GATE_ENTRY
  TICKET_LOOKUP
}

enum TicketScanAttemptResult {
  ENTRY_GRANTED
  ALREADY_SCANNED
  CANCELLED
  NOT_YET_VALID
  ENTRY_WINDOW_CLOSED
  WRONG_EVENT
  NOT_FOUND
  INVALID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model WaiverVersion {
  id String @id @default(cuid())

  eventWaiverId String
  eventWaiver   EventWaiver @relation(fields: [eventWaiverId], references: [id])

  sourceTemplateId String
  sourceTemplate   WaiverTemplate @relation(fields: [sourceTemplateId], references: [id])

  version Int

  title               String
  content             String @db.Text
  acceptanceStatement String @db.Text
  contentHash         String

  status WaiverVersionStatus @default(DRAFT)

  publishedAt       DateTime?
  publishedByUserId String?
  publishedByUser   User?     @relation(fields: [publishedByUserId], references: [id])

  createdAt DateTime @default(now())

  submissions WaiverSubmission[]

  @@unique([eventWaiverId, version])
  @@index([eventWaiverId, status])
}

model WaiverSubmission {
  id String @id @default(cuid())

  eventWaiverId String
  eventWaiver   EventWaiver @relation(fields: [eventWaiverId], references: [id])

  waiverVersionId String
  waiverVersion   WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  signatoryFullName String
  signatureData     String @db.Text

  acceptedAt DateTime @default(now())

  waiverContentHash       String
  acceptanceStatementHash String

  verificationTokenHash String @unique

  minors WaiverMinor[]

  createdAt DateTime @default(now())

  @@index([eventWaiverId, acceptedAt])
  @@index([waiverVersionId])
  @@index([signatoryFullName])
}

model WaiverMinor {
  id String @id @default(cuid())

  waiverSubmissionId String
  waiverSubmission   WaiverSubmission @relation(fields: [waiverSubmissionId], references: [id], onDelete: Cascade)

  fullName    String
  dateOfBirth DateTime @db.Date

  createdAt DateTime @default(now())

  @@index([waiverSubmissionId])
}
